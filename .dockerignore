# Docker Ignore File for KabanAI

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/

# Database (will be in volume)
data/aiboard.db
data/workdirs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (keep in image but not needed for build)
*.md
!requirements.txt

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Node modules (if any)
node_modules/

# Backup files
*_old.*
*_backup.*
*.bak
